{
  "name": "web-scraper",
  "version": "1.0.0",
  "description": "All-in-one modular web scraper & data extraction suite built with TypeScript and Node.js. High-performance, structured SQLite/JSON/CSV outputs, and extensible scraper plugins architecture.",
  "main": "dist/index.js",
  "type": "module",
  "homepage": "https://zeltoria.web.id",
  "author": "Zeltoria Aevryns (https://zeltoria.web.id)",
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc",
    "animeindo": "tsx src/cli.ts animeindo",
    "animeindo:all": "tsx src/cli.ts animeindo --all",
    "animeindo:details": "tsx src/cli.ts animeindo --details --concurrency 25",
    "animeindo:movies": "tsx src/cli.ts animeindo --movies",
    "animeindo:genres": "tsx src/cli.ts animeindo --genres",
    "animeindo:updates": "tsx src/cli.ts animeindo --updates",
    "animeindo:summary": "tsx src/cli.ts animeindo --summary",
    "dracinema": "tsx src/cli.ts dracinema",
    "dracinema:all": "tsx src/cli.ts dracinema --all",
    "dracinema:movies": "tsx src/cli.ts dracinema --movies",
    "dracinema:genres": "tsx src/cli.ts dracinema --genres",
    "dracinema:collections": "tsx src/cli.ts dracinema --collections",
    "dracinema:search": "tsx src/cli.ts dracinema --search",
    "dracinema:playback": "tsx src/cli.ts dracinema --playback",
    "dracinema:summary": "tsx src/cli.ts dracinema --summary",
    "summary": "tsx src/cli.ts animeindo --summary",
    "scrape:all": "tsx src/cli.ts animeindo --all",
    "scrape:details": "tsx src/cli.ts animeindo --details --concurrency 25",
    "scrape:movies": "tsx src/cli.ts animeindo --movies",
    "scrape:genres": "tsx src/cli.ts animeindo --genres",
    "scrape:updates": "tsx src/cli.ts animeindo --updates"
  },
  "keywords": [
    "web-scraper",
    "scraper",
    "crawler",
    "anime-scraper",
    "anime-api",
    "dracinema",
    "drama-china",
    "animeindo",
    "data-extraction",
    "typescript",
    "nodejs",
    "cheerio",
    "sqlite",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
