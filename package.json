{
  "name": "anime-indo-scraper",
  "version": "1.0.0",
  "description": "High-performance TypeScript/Node.js scraper for anime-indo.lol and dracinema.com",
  "main": "dist/index.js",
  "type": "module",
  "homepage": "https://zeltoria.web.id",
  "author": "Zeltoria Aevryns (https://zeltoria.web.id)",
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc",
    "scrape:all": "tsx src/cli.ts --all",
    "scrape:details": "tsx src/cli.ts --details --concurrency 25",
    "scrape:movies": "tsx src/cli.ts --movies",
    "scrape:genres": "tsx src/cli.ts --genres",
    "scrape:updates": "tsx src/cli.ts --updates",
    "summary": "tsx src/cli.ts --summary",
    "dracinema": "tsx src/dracinema/cli.ts",
    "dracinema:all": "tsx src/dracinema/cli.ts --all",
    "dracinema:movies": "tsx src/dracinema/cli.ts --movies",
    "dracinema:genres": "tsx src/dracinema/cli.ts --genres",
    "dracinema:collections": "tsx src/dracinema/cli.ts --collections",
    "dracinema:summary": "tsx src/dracinema/cli.ts --summary"
  },
  "keywords": [
    "anime",
    "anime-scraper",
    "anime-api",
    "dracinema",
    "drama-china",
    "animeindo",
    "cheerio",
    "crawler",
    "nodejs",
    "scraper",
    "sqlite",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
